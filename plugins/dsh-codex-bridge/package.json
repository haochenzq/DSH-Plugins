{
  "name": "@local/dsh-codex-bridge",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./chat-ui.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "protocol.js",
    "client.js",
    "live-channel.js",
    "live-client.js",
    "live-send.js",
    "chat-ui.js",
    "direct-chat.js",
    "turn-channel.js",
    "dsh-turn-guard.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "configure-hooks.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
