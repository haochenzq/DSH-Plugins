{
  "name": "dsh-cosmos-theme",
  "version": "0.3.5",
  "description": "深空探索 · Cosmos：可切换场景与动效的本地宇宙主题。",
  "type": "module",
  "engines": {"dsh": ">=0.2.2-rc.1 <0.3.0"},
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-theme"]}}
}
